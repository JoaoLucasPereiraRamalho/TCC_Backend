# Copie para .env e ajuste. Validado por src/platform/config/env.schema.ts.

# api | worker (o main de cada processo também força o seu valor)
PROCESS_ROLE=api
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL (docker-compose.yml)
DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack?schema=public

# Armazenamento S3-compatível (MinIO local no docker-compose)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=fittrack-local
STORAGE_ACCESS_KEY=fittrack
STORAGE_SECRET_KEY=fittrack-secret

# JWT (RFC 8725: algoritmo fixo, iss e aud conferidos). Troque o segredo fora do ambiente local.
JWT_ISSUER=fittrack-api
JWT_AUDIENCE=fittrack-clients
JWT_ACCESS_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900

# Versão mínima do app mobile (426 UPDATE_REQUIRED abaixo dela)
MIN_APP_VERSION=1.0.0
